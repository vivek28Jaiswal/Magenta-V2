# Magenta Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# If MongoDB is not running locally or remotely, Magenta automatically starts an embedded in-memory MongoDB
MONGODB_URI=mongodb://localhost:27017/magenta

# JWT Secret
JWT_SECRET=magenta_secret_key_change_in_production_jwt_2026

# AI Provider Configuration
# Choose: gemini | openai | fallback
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Job Ingestion Sources (optional external keys, Remotive is free and requires no key)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
